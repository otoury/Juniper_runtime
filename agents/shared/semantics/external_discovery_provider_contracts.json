{
  "version": 1,
  "contracts": [
    {
      "id": "external_discovery_provider",
      "contract_version": 1,
      "description": "Shared metadata-only contract for external discovery providers. Provider declarations describe bounded runtime capabilities only; they do not authorize execution.",
      "required_declaration_fields": [
        "provider_id",
        "provider_type",
        "execution_mode",
        "governance_state",
        "external",
        "cost_bearing",
        "governed",
        "non_executing",
        "governance",
        "cost_policy",
        "supported_output_types",
        "max_queries",
        "max_results",
        "max_cost",
        "execution_bounds",
        "source_requirements",
        "citation_requirements"
      ],
      "allowed_provider_types": [
        "cloud_ai",
        "search_api"
      ],
      "allowed_execution_modes": [
        "declaration_only"
      ],
      "allowed_governance_states": [
        "enabled",
        "audit_only",
        "disabled"
      ],
      "allowed_output_types": [
        "external_discovery_result_set",
        "external_discovery_source_reference"
      ],
      "ownership": {
        "scope": "shared_runtime_capability",
        "domain_neutral_required": true,
        "agent_owned_provider_ids_forbidden": true
      },
      "execution_policy": {
        "execution_allowed": false,
        "network_calls_allowed": false,
        "cloud_model_calls_allowed": false,
        "normalization_allowed": false,
        "delivery_allowed": false
      },
      "forbidden_declaration_fields": [
        "adapter_callable",
        "agent_id",
        "browser_callable",
        "datasource_path",
        "delivery_target",
        "domain",
        "domain_output_type",
        "execute",
        "executor",
        "gateway",
        "model",
        "normalizer",
        "outreach_template",
        "prompt",
        "ranking",
        "summarizer",
        "summary_prompt",
        "telegram"
      ]
    }
  ],
