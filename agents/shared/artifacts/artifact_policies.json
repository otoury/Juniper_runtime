  "lower_third": {
    "persist_as_artifact": true,
    "preferred_engine": "local_agent",
    "fallback_engines": [
      "local_router_primary",
      "cloud_fast",
      "cloud_deep"
    ],
    "reasoning_depth": "low",
    "style_sensitivity": "high",
    "latency_preference": "fast",
    "formatting_constraints": {
      "non_empty": true,
      "single_line": true,
      "max_words": 8,
      "must_not_end_with_period": true,
      "forbid_meta_response": true,
      "meta_markers": [
        "here is",
        "here's",
        "here’s",
        "option:",
        "headline:",
        "draft:",
        "response:"
      ]
    },
    "transforms": [
      "shorten",
      "tighten",
      "seriousify",
      "humorize",
      "intensify",
      "make more punchy"
    ],
    "extract_fields": [
      "content",
      "lower_third"
    ]
  },
